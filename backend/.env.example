# Copy to backend/.env using setup-env.cmd or setup-env.sh.
# Local development only. Spring Boot reads this as a Java .properties file.
# Do NOT commit backend/.env; keep passwords and private keys out of Git.
OYS_DB_URL=jdbc:postgresql://127.0.0.1:5432/oys_elibrary
OYS_DB_USER=oys_elibrary_app
OYS_DB_PASSWORD=REPLACE_WITH_A_REAL_SECRET

# Replace with the actual issuer and public JWKS endpoint of your OYS login service.
# Invalid placeholders intentionally cannot authenticate: no bypass is provided.
OYS_JWT_ISSUER=https://id.oys.example.invalid/
OYS_JWKS_URI=https://id.oys.example.invalid/.well-known/jwks.json
OYS_JWT_AUDIENCE=oys-elibrary
PORT=8080
