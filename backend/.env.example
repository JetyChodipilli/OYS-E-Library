# Copy to backend/.env using setup-env.cmd or setup-env.sh; never commit the copy.
# Spring Boot imports .env as a Java .properties file (plain URLs, not Markdown).
# Choose existing local PostgreSQL OR the Docker dev service, not both.
OYS_DB_URL=jdbc:postgresql://127.0.0.1:5432/oys_elibrary
OYS_DB_USER=oys_elibrary_app
OYS_DB_PASSWORD=

# Real local URLs AFTER local Keycloak starts and imports the oys realm.
# Production must use an HTTPS issuer on a domain you control.
OYS_JWT_ISSUER=http://localhost:8180/realms/oys
OYS_JWKS_URI=http://localhost:8180/realms/oys/protocol/openid-connect/certs
OYS_JWT_AUDIENCE=oys-elibrary
PORT=8080
